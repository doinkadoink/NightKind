{% doc %}
  NightKind sticker artwork pulled from nightkind.org and shown on the Shopify homepage.
{% enddoc %}

<div class="section-background color-{{ section.settings.color_scheme }}"></div>
<section class="section section--page-width nightkind-gallery color-{{ section.settings.color_scheme }}">
  <h2 class="nightkind-gallery__title">{{ section.settings.heading }}</h2>
  <p class="nightkind-gallery__intro">{{ section.settings.intro }}</p>
  <div class="nightkind-gallery__grid">
    {% for block in section.blocks %}
      <article class="nightkind-gallery__card" {{ block.shopify_attributes }}>
        <img
          src="{{ block.settings.image_file | asset_url }}"
          alt="{{ block.settings.title | escape }}"
          width="600"
          height="600"
          loading="lazy"
        >
        <h3>{{ block.settings.title }}</h3>
      </article>
    {% endfor %}
  </div>
</section>

{% schema %}
{
  "name": "NightKind sticker gallery",
  "tag": "section",
  "class": "nightkind-gallery-section",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Stickers"
    },
    {
      "type": "textarea",
      "id": "intro",
      "label": "Intro",
      "default": "Artwork from nightkind.org. Every purchase supports bat conservation through Bats QLD."
    },
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "Color scheme",
      "default": "scheme-1"
    }
  ],
  "blocks": [
    {
      "type": "sticker",
      "name": "Sticker",
      "settings": [
        {
          "type": "text",
          "id": "image_file",
          "label": "Asset filename"
        },
        {
          "type": "text",
          "id": "title",
          "label": "Title"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "NightKind sticker gallery"
    }
  ]
}
{% endschema %}
